# ==============================================================================
# Frontend Environment Configuration
# NOTE: These variables are exposed to the browser client (prefixed with VITE_)
# NEVER put private API keys or service role secrets here!
# ==============================================================================

# Supabase Client Configuration (Public Anon Key is safe in the browser)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# FastAPI Backend API Base URL
VITE_API_BASE_URL=http://localhost:8000
