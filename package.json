{
  "name": "healthcare-saas",
  "version": "1.0.0",
  "description": "Healthcare SaaS - run frontend + backend with one command",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --prefix-colors \"cyan,magenta\" --names \"FRONTEND,BACKEND\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && .venv\\Scripts\\uvicorn app.main:app --reload --port 8000",
    "build": "cd frontend && npm run build",
    "test:backend": "cd backend && .venv\\Scripts\\pytest tests"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
