# ==============================================================================
# Backend Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Supabase Project Credentials
# Find these in your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY is public/browser-safe, used here as fallback
SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY MUST REMAIN SERVER-SIDE ONLY - NEVER EXPOSE TO FRONTEND!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# SUPABASE_JWT_SECRET is in Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# PostgreSQL Database Connection URL (Direct or Transaction Pooler)
# Format: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or for local development/testing: sqlite+aiosqlite:///./healthcare_dev.db
DATABASE_URL=sqlite+aiosqlite:///./healthcare_dev.db
